# Supabase Configuration
# Get these from your Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# REQUIRED: Service Role Key
# Get this from Supabase Dashboard → Settings → API → service_role key
# This is needed for anonymous survey submissions to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# A/B Testing Configuration
# Enable/disable A/B testing for surveys
NEXT_PUBLIC_SURVEY_AB_TEST_ENABLED=true
# Percentage of users assigned to Survey B (0-100)
NEXT_PUBLIC_SURVEY_B_PERCENTAGE=50

# Live Odds API
# Get a key from https://the-odds-api.com/
NEXT_PUBLIC_ODDS_API_KEY=your-odds-api-key-here

# RapidAPI Sportsbook API
# Get a key from https://rapidapi.com/sportsbook-api-sportsbook-api-default/api/sportsbook-api2
# Provides real-time odds from 10+ US sportsbooks across 20+ sports
NEXT_PUBLIC_RAPIDAPI_SPORTSBOOK_KEY=your-rapidapi-key-here

# AI Bet Advisor (Elite Feature)
# The AI Bet Advisor provides comprehensive betting analysis combining:
# - Technical betting insights (EV, odds analysis, statistics)
# - Emotional psychology assessment (state detection, risk triggers)
# - Harm reduction recommendations (budget management, waiting periods)
#
# This feature is gated to Elite subscribers and runs entirely server-side.
# No additional API keys required - uses built-in analysis algorithms.

# AWS Bedrock Configuration (Optional - for enhanced AI analysis with Claude)
# Get your AWS credentials from AWS IAM Console
# Bedrock must be enabled in your AWS account (us-east-1, us-west-2, or eu-west-1 recommended)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
# Model ID for Claude on Bedrock (use Claude 3.5 Sonnet for best results)
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Enable enhanced AI analysis (set to 'true' to use Claude, 'false' to use built-in algorithms)
ENABLE_ENHANCED_AI_ANALYSIS=true
