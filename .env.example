# TheSportsDB API and Supporting Rest APIs
NEXT_PUBLIC_THESPORTSDB_API_KEY=123
NEXT_PUBLIC_THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v2/json
THESPORTSDB_SEARCH_LEAGUE=/search/league/
THESPORTSDB_SEARCH_TEAM=/search/team/
THESPORTSDB_SEARCH_PLAYER=/search/player/
THESPORTSDB_SEARCH_EVENT=/search/event/
THESPORTSDB_SEARCH_VENUE=/search/venue/ # example /api/v2/json/search/venue/wembley
THESPORTSDB_LOOKUP_LEAGUE=/lookup/league/number # example /api/v2/json/lookup/league/4328
THESPORTSDB_LOOKUP_TEAM=/lookup/team/number # example /api/v2/json/lookup/team/133597
THESPORTSDB_LOOKUP_TEAM_EQUIPMENT=/lookup/team_equipment/number # example /api/v2/json/lookup/team_equipment/133597
THESPORTSDB_LOOKUP_PLAYER=/lookup/player/number # example  /api/v2/json/lookup/player/34172575
THESPORTSDB_LOOKUP_PLAYER_CONTRACT=/lookup/player_contract/number # example /api/v2/json/lookup/player_contracts/34146304
THESPORTSDB_LOOKUP_PLAYER_RESULTS=/lookup/player_results/number # example /api/v2/json/lookup/player_results/34160573
THESPORTSDB_LOOKUP_PLAYER_HONOURS=/lookup/player_honours/number # example  /api/v2/json/lookup/player_honours/34146304
THESPORTSDB_LOOKUP_PLAYER_MILESTONES=/lookup/player_milestones/number # example /api/v2/json/lookup/player_milestones/34146304
THESPORTSDB_LOOKUP_PLAYER_FORMER_TEAMS=/lookup/player_teams/number # example /api/v2/json/lookup/player_teams/34146304
THESPORTSDB_LOOKUP_EVENT=/lookup/event/number # example /api/v2/json/lookup/event/441613
THESPORTSDB_LOOKUP_EVENT_LINEUP=/lookup/event_lineup/number # example /api/v2/json/lookup/event_lineup/1937584
THESPORTSDB_LOOKUP_EVENT_RESULTS=/lookup/event_results/number # example /api/v2/json/lookup/event_results/652890
THESPORTSDB_LOOKUP_EVENT_STATS=/lookup/event_stats/number # example /api/v2/json/lookup/event_stats/1937584
THESPORTSDB_LOOKUP_EVENT_TIMELINE=/lookup/event_timeline/number # example /api/v2/json/lookup/event_timeline/1937584
THESPORTSDB_LOOKUP_EVENT_TV=/lookup/event_tv/number # example /api/v2/json/lookup/event_tv/584911
THESPORTSDB_LOOKUP_EVENT_HIGHLIGHTS=/lookup/event_highlights/number # example /api/v2/json/lookup/event_highlights/2044892
THESPORTSDB_LOOKUP_VENUE=/lookup/venue/number # example /api/v2/json/lookup/venue/15910
THESPORTSDB_LIST_LEAGUE_TEAMS=/list/teams/number # example /api/v2/json/list/teams/4328
THESPORTSDB_LIST_LEAGUE_SEASON=/list/seasons/number # example /api/v2/json/list/seasons/4328
THESPORTSDB_LIST_LEAGUE_SEASON_POSTERS=/list/seasonposters/number # example /api/v2/json/list/seasonposters/4328
THESPORTSDB_LIST_TEAM_PLAYERS=/list/players/number # example /api/v2/json/list/players/133604
THESPORTSDB_FILTER_TV_EVENTS_BY_DATE=/filter/tv/day/year-month-day # example /api/v2/json/filter/tv/day/2024-06-22
THESPORTSDB_FILTER_TV_EVENTS_BY_COUNTRY=/filter/tv/country/nameofcountry #example /api/v2/json/filter/tv/country/united_kingdom
THESPORTSDB_FILTER_TV_EVENTS_BY_SPORT=/filter/tv/sport/nameofsport # example /api/v2/json/filter/tv/sport/motorsport
THESPORTSDB_FILTER_TV_EVENTS_BY_CHANNEL=/filter/tv/channel/nameofchannel # example /api/v2/json/filter/tv/channel/sky_sports_main_event
THESPORTSDB_FILTER_TV_EVENTS_BY_CHANNEL_ID=/filter/tv/channelid/number # example /api/v2/json/filter/tv/channelid/3834
THESPORTSDB_ALL_COUNTRIES=/all/countries # example /api/v2/json/all/countries
THESPORTSDB_ALL_SPORTS=/all/sports # example /api/v2/json/all/sports
THESPORTSDB_ALL_LEAGUES=/all/leagues # example /api/v2/json/all/leagues
THESPORTSDB_NEXT_10_EVENTS_IN_LEAGUE=/schedule/next/league/number # example  /api/v2/json/schedule/next/league/4328
THESPORTSDB_PREVIOUS_10_EVENTS_IN_LEAGUE=/schedule/previous/league/number # example /api/v2/json/schedule/previous/league/4328
THESPORTSDB_NEXT_10_EVENTS_IN_TEAM=/schedule/next/team/number # example /api/v2/json/schedule/next/team/133612
THESPORTSDB_PREVIOUS_10_EVENTS_IN_TEAM=/schedule/previous/team/number # example /api/v2/json/schedule/previous/team/133612
THESPORTSDB_NEXT_10_EVENTS_IN_VENUE=/schedule/next/venue/number # example /api/v2/json/schedule/next/venue/24413
THESPORTSDB_PREVIOUS_10_EVENTS_IN_VENUE=/schedule/previous/venue/number # example /api/v2/json/schedule/previous/venue/24413
THESPORTSDB_FULL_TEAM_SEASON_SCHEDULE=/schedule/full/team/teamnumber # example /api/v2/json/schedule/full/team/133612
THESPORTSDB_FULL_LEAGUE_SEASON_SCHEDULE=/schedule/league/leaguenumber/leagueyear # example /api/v2/json/schedule/league/4328/2023-2024
THESPORTSDB_LIVESCORE_SPORT=/livescore/sport # example /api/v2/json/livescore/soccer
THESPORTSDB_LIVESCORE_LEAGUE=/livescore/leaguenumber # example /api/v2/json/livescore/4399
THESPORTSDB_LIVESCORE_ALL=/livescore/all # example /api/v2/json/livescore/all
NEXT_PUBLIC_THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v2/json
NEXT_PUBLIC_THESPORTSDB_API_KEY=123   # replace with your real key