# Copy this file to .env.local and fill in the values you have.
# .env.local is gitignored. Leave unused integrations empty.

# Supabase. Required for sign-in and for data that persists past the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used for metadata, sitemap, and auth redirect links.
# When unset, the app falls back to https://www.playmindlabs.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini. /api/analyze-bet returns 503 when this is unset.
# /api/ai/analyze-bet still runs its built-in analysis without it.
GOOGLE_GEMINI_API_KEY=
ENABLE_ENHANCED_AI_ANALYSIS=
GOOGLE_GEMINI_MODEL_AI=

# Odds providers. TheSportsDB requests fall back to key "123" in code when unset.
NEXT_PUBLIC_ODDS_API_KEY=
ODDS_API_KEY=
NEXT_PUBLIC_RAPIDAPI_SPORTSBOOK_KEY=
NEXT_PUBLIC_THESPORTSDB_API_KEY=

# Flowglad billing. isFlowgladConfigured() is false when the secret is empty.
FLOWGLAD_SECRET_KEY=
FLOWGLAD_WEBHOOK_SECRET=
NEXT_PUBLIC_FLOWGLAD_PUBLIC_KEY=
FLOWGLAD_PRICE_PREMIUM=
FLOWGLAD_PRICE_PREMIUM_PLUS=
FLOWGLAD_PRICE_ELITE=

# Optional integrations. Email alerts are logged only when credentials are missing.
OPENWEATHER_API_KEY=
EMAIL_USER=
EMAIL_PASS=
ALERT_EMAIL=

# Survey assignment. A/B assignment stays enabled unless the flag is "false".
NEXT_PUBLIC_SURVEY_AB_TEST_ENABLED=
NEXT_PUBLIC_SURVEY_B_PERCENTAGE=

# Feature flags read in lib/features/flags.ts
NEXT_PUBLIC_FEATURE_HYBRID_SURVEY=
NEXT_PUBLIC_FEATURE_PGSI_INTEGRATION=
NEXT_PUBLIC_FEATURE_ES_V2=
